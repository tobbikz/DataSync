# Drop-in for /etc/my.cnf.d/ — GTID + ROW binlog for CDC capture.
# Install: sudo scripts/enable_mariadb_gtid.sh
#   or: sudo cp deploy/mariadb/mariadb-gtid.cnf /etc/my.cnf.d/datalake-gtid.cnf

[mysqld]
log_bin = /var/lib/mysql/mysql-bin
binlog_format = ROW
binlog_row_image = FULL
expire_logs_days = 7
gtid_strict_mode = ON
log_slave_updates = ON
