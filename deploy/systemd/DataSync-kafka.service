[Unit]
Description=DataSync Kafka broker (Docker/Podman compose)
Documentation=file://@DATASYNC_ROOT@/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=datalake
Group=datalake
WorkingDirectory=@DATASYNC_ROOT@
Environment=XDG_RUNTIME_DIR=/run/user/@DATASYNC_UID@
EnvironmentFile=-/etc/datasync/datasync.env
ExecStart=@DATASYNC_ROOT@/deploy/systemd/datasync-kafka-start.sh
ExecStop=@DATASYNC_ROOT@/deploy/systemd/datasync-kafka-stop.sh
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
