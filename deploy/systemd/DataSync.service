[Unit]
Description=DataSync (Kafka + CDC daemon — Podman compose)
Documentation=file://@DATASYNC_ROOT@/README.md
After=network-online.target
Requires=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=datalake
Group=datalake
WorkingDirectory=@DATASYNC_ROOT@
Environment=XDG_RUNTIME_DIR=/run/user/@DATASYNC_UID@
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/@DATASYNC_UID@/bus
EnvironmentFile=-/etc/datasync/datasync.env
ExecStartPre=/bin/bash @DATASYNC_ROOT@/deploy/systemd/datasync-build.sh
ExecStart=/bin/bash @DATASYNC_ROOT@/deploy/systemd/datasync-start.sh
ExecStop=/bin/bash @DATASYNC_ROOT@/deploy/systemd/datasync-stop.sh
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
