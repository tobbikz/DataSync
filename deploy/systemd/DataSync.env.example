# DataSync systemd environment (installed to /etc/datasync/datasync.env)
DATASYNC_ROOT=@DATASYNC_ROOT@
DATASYNC_CONFIG=@DATASYNC_ROOT@/config.json

# deploy mode: docker (default) | native
DATASYNC_DEPLOY_MODE=docker

# Native-only (when DATASYNC_DEPLOY_MODE=native)
# DATASYNC_BIN=@DATASYNC_ROOT@/cpp/build/DataSync

# Docker CLI / one-shot jobs
KAFKA_BOOTSTRAP=localhost:9092
