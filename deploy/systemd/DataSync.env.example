# DataSync systemd environment (installed to /etc/datasync/datasync.env)
DATASYNC_ROOT=@DATASYNC_ROOT@
DATASYNC_CONFIG=@DATASYNC_ROOT@/config.json
DATASYNC_RUN_USER=datalake
DATASYNC_UID=@DATASYNC_UID@

KAFKA_BOOTSTRAP=localhost:9092
# DOCKER_HOST set by install-systemd.sh for rootless podman (datalake user)
