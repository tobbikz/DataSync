# DataSync ops UI — copy to .env.local for local overrides.
# Defaults work for lab; change secrets before any shared/prod deploy.

DATASYNC_UI_USER=admin
DATASYNC_UI_PASSWORD=datasync
DATASYNC_UI_SECRET=change-me-in-production

# Optional: override PostgreSQL catalog instead of reading ../config.json
# DATASYNC_PG_HOST=127.0.0.1
# DATASYNC_PG_PORT=5432
# DATASYNC_PG_DATABASE=datasync
# DATASYNC_PG_USER=datasync
# DATASYNC_PG_PASSWORD=CHANGE_ME

# DATASYNC_CONFIG=../config.json
# KAFKA_BOOTSTRAP=127.0.0.1:9092
# PORT=3000
