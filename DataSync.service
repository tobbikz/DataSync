# systemd unit — install once (or after git pull if unit changed):
#   sudo ./install.sh systemd-install
#   sudo systemctl enable --now DataSync
#
# Restart (rebuild + recreate daemon): sudo systemctl restart DataSync
# Logs: journalctl -u DataSync -n 50  &&  docker compose logs -f datasync

[Unit]
Description=DataSync (Kafka + CDC daemon)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=@DATASYNC_ROOT@
Environment=DATASYNC_AUTO_DISCOVER=1
Environment=KAFKA_BOOTSTRAP=127.0.0.1:9092
EnvironmentFile=-/etc/datasync/datasync.env
ExecStart=@DATASYNC_ROOT@/install.sh start
ExecStop=@DATASYNC_ROOT@/install.sh stop
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
