# systemd unit — install once:
#   sudo cp DataSync.service /etc/systemd/system/
#   sudo sed -i "s|@DATASYNC_ROOT@|$(pwd)|g" /etc/systemd/system/DataSync.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now DataSync
#
# Logs: journalctl -u DataSync -f

[Unit]
Description=DataSync (Kafka + CDC daemon)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@DATASYNC_ROOT@
Environment=DATASYNC_FOREGROUND=1
Environment=DATASYNC_AUTO_DISCOVER=1
Environment=KAFKA_BOOTSTRAP=127.0.0.1:9092
EnvironmentFile=-/etc/datasync/datasync.env
ExecStart=@DATASYNC_ROOT@/install.sh
TimeoutStartSec=900
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
